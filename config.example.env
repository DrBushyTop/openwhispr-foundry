# Copy to config.env and uncomment what you want to change. config.env is
# gitignored. The shim reads it at startup, and install-launchagent.sh and
# openwhispr-patch/build.sh read SHIM_PORT from it. Env vars set in your shell
# override it.
#
# Format: KEY=value, one per line, no spaces around "=" and no quotes needed.
#
# The values below are the defaults, which point at my Azure resources.
# Restart the shim after a change:
#   launchctl kickstart -k gui/$(id -u)/net.huuhka.openwhispr-foundry-shim

# Entra tenant for `az account get-access-token`. Leave empty to use the
# tenant az is logged in to.
#FOUNDRY_TENANT_ID=7135bcf1-5a12-4e82-ad41-c263afa243e8

# Speech-to-text. Resource URLs from the Azure portal (Keys and Endpoint).
# LLM Speech is only in some regions (centralindia, eastus, northeurope,
# southeastasia, westus, westus2). Both can be the same resource.
#FOUNDRY_MAI_ENDPOINT=https://opencode-lpqn3wrkin5y2.cognitiveservices.azure.com
#FOUNDRY_LLM_SPEECH_ENDPOINT=https://opencode-neu-lpqn3wrkin5y2.cognitiveservices.azure.com

# Backend when OpenWhispr's Model field is empty: mai-transcribe-2,
# mai-transcribe-1.5 or llm-speech.
#FOUNDRY_DEFAULT_MODEL=mai-transcribe-2

# MAI style: clean drops fillers like "um", verbatim keeps them.
#FOUNDRY_MAI_STYLE=clean

# Language models. The resource's OpenAI v1 URL, and the deployment names
# OpenWhispr's Refresh button lists. Other deployment names still work if you
# type them in.
#FOUNDRY_CHAT_ENDPOINT=https://opencode-lpqn3wrkin5y2.openai.azure.com/openai/v1
#FOUNDRY_CHAT_MODELS=gpt-5.4-mini,gpt-5.4-nano,gpt-6-luna,gpt-6-sol

# Meetings (patched app only). Backend for realtime segments, and the quietest
# audio pause detection counts as speech, in int16 RMS (300 is about -40 dBFS).
# The detector also adapts to background noise on its own.
#FOUNDRY_REALTIME_MODEL=mai-transcribe-2
#FOUNDRY_VAD_MIN_RMS=300

# Where the shim listens. After changing the port, re-run install-launchagent.sh
# so the meetings URL follows, and update the URLs in OpenWhispr's settings.
#SHIM_HOST=127.0.0.1
#SHIM_PORT=9447
