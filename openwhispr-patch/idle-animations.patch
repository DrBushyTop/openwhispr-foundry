diff --git a/src/utils/windowActivity.ts b/src/utils/windowActivity.ts
new file mode 100644
index 000000000..f748bd238
--- /dev/null
+++ b/src/utils/windowActivity.ts
@@ -0,0 +1,65 @@
+import { isControlPanelWindow } from "./windowContext";
+
+// Local patch: idle animations.
+//
+// On macOS WindowServer composites every frame a window draws, so a looping
+// animation costs GPU for as long as it's on screen, even in a window nobody
+// is looking at. The control panel disables background throttling, so
+// Chromium keeps drawing it at the display's full refresh rate (120 Hz on
+// ProMotion) while it sits next to a meeting app.
+//
+// The control panel counts as idle while it doesn't have focus. The dictation
+// panel and its assistant overlay never take focus, so for them only a hidden
+// document counts as idle.
+
+export function isWindowIdle(): boolean {
+  if (typeof document === "undefined") return false;
+  if (document.visibilityState !== "visible") return true;
+  // A window with focus, or one that can't tell, counts as watched.
+  if (document.hasFocus?.() !== false) return false;
+  return isControlPanelWindow();
+}
+
+const isLooping = (animation: Animation): boolean =>
+  animation.effect?.getTiming().iterations === Infinity;
+
+/**
+ * Pauses looping CSS and Web animations (spinners, pulses, shimmers) while
+ * the window is idle and resumes them when it isn't. Finite animations keep
+ * running, so content that fades in while idle still appears. Call once per
+ * window.
+ */
+export function pauseLoopingAnimationsWhileIdle(): void {
+  const paused = new Set<Animation>();
+
+  const pauseRunning = () => {
+    for (const animation of document.getAnimations()) {
+      if (animation.playState === "running" && isLooping(animation)) {
+        animation.pause();
+        paused.add(animation);
+      }
+    }
+  };
+
+  const update = () => {
+    if (isWindowIdle()) {
+      pauseRunning();
+      return;
+    }
+    for (const animation of paused) {
+      // A paused animation whose element left the DOM is already idle.
+      if (animation.playState === "paused") animation.play();
+    }
+    paused.clear();
+  };
+
+  window.addEventListener("focus", update);
+  window.addEventListener("blur", update);
+  document.addEventListener("visibilitychange", update);
+  // Catches loops that start while idle, such as a spinner a background
+  // task shows, without polling.
+  document.addEventListener("animationstart", () => {
+    if (isWindowIdle()) pauseRunning();
+  });
+  update();
+}
