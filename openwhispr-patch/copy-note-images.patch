+// A copy with screenshots in it: ProseMirror fills the clipboard as usual, with
+// openwhispr-media:// links other apps can't load, and the main process then
+// rewrites it with the images embedded (noteMedia.js). A paste within a moment
+// of copying can still get the first version.
+function copyWithImages(view: EditorView) {
+  const copyNoteWithImages = window.electronAPI?.copyNoteWithImages;
+  if (!copyNoteWithImages || view.state.selection.empty) return;
+  const slice = view.state.selection.content();
+  let hasImage = false;
+  slice.content.descendants((node) => {
+    if (node.type.name === "image") hasImage = true;
+    return !hasImage;
+  });
+  if (!hasImage) return;
+  const { dom, text } = view.serializeForClipboard(slice);
+  void copyNoteWithImages(dom.innerHTML, text);
+}
