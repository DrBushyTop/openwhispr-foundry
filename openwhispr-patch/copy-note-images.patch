 // After app ready: serve the files, register IPC, and clean up in the background.
+// Local patch: copying notes with screenshots. Other apps can't load
+// openwhispr-media:// links, so OneNote, Word or Mail dropped the images from
+// a copied note. The copy goes out with each screenshot embedded as a data:
+// URL instead, sized in screen points so a Retina capture pastes at the size
+// it had on screen.
+const NOTE_MEDIA_SRC_RE = /src="openwhispr-media:\/\/image\/([^"]+)"/g;
+
+async function embeddedImage(name, scaleFactor) {
+  const file = mediaPath(name);
+  if (!file) return null;
+  const data = await fs.promises.readFile(file);
+  const { width } = nativeImage.createFromBuffer(data).getSize();
+  return {
+    src: `data:${mimeFor(name)};base64,${data.toString("base64")}`,
+    width: width ? Math.round(width / scaleFactor) : null,
+  };
+}
+
+async function embedImages(html) {
+  const scaleFactor = screen.getPrimaryDisplay().scaleFactor || 1;
+  const images = new Map();
+  for (const name of findNoteMediaNames(html)) {
+    try {
+      images.set(name, await embeddedImage(name, scaleFactor));
+    } catch (error) {
+      log().warn("Embedding copied screenshot failed", { name, error: error.message }, "noteMedia");
+    }
+  }
+  return html.replace(NOTE_MEDIA_SRC_RE, (match, name) => {
+    const image = images.get(name);
+    if (!image) return match;
+    return image.width ? `src="${image.src}" width="${image.width}"` : `src="${image.src}"`;
+  });
+}
