diff --git a/src/services/ai/noteImageContent.ts b/src/services/ai/noteImageContent.ts
new file mode 100644
index 00000000..526ecd64
--- /dev/null
+++ b/src/services/ai/noteImageContent.ts
@@ -0,0 +1,30 @@
+import type { ReasoningConfig } from "../BaseReasoningService";
+
+/**
+ * Local patch: the user message as content parts when a note action carries
+ * screenshots (config.noteImages), or null when it carries none. Order: the note
+ * text, the screenshot instructions, then each screenshot preceded by its label.
+ */
+export function noteImageUserContent(
+  text: string,
+  config: ReasoningConfig,
+  dialect: "chat" | "responses" = "chat"
+): Array<Record<string, unknown>> | null {
+  const attachments = config.noteImages;
+  if (!attachments?.images?.length) return null;
+
+  const textPart = (value: string) =>
+    dialect === "responses" ? { type: "input_text", text: value } : { type: "text", text: value };
+  const imagePart = (image: { mediaType: string; data: string }) => {
+    const url = `data:${image.mediaType};base64,${image.data}`;
+    return dialect === "responses"
+      ? { type: "input_image", image_url: url, detail: "high" }
+      : { type: "image_url", image_url: { url, detail: "high" } };
+  };
+
+  return [
+    textPart(text),
+    textPart(attachments.instructions),
+    ...attachments.images.flatMap((image) => [textPart(`${image.label}:`), imagePart(image)]),
+  ];
+}
