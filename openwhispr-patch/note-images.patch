diff --git a/src/utils/noteScreenshots.ts b/src/utils/noteScreenshots.ts
new file mode 100644
index 00000000..6ce5423a
--- /dev/null
+++ b/src/utils/noteScreenshots.ts
@@ -0,0 +1,182 @@
+// Local patch: screenshots pasted into a note, sent to note actions as images.
+//
+// In the text the model reads, each screenshot link becomes "[Screenshot N, pasted HH:MM]",
+// both where it sits in the user's notes and at the matching point of the meeting
+// transcript. The images themselves travel as ReasoningConfig.noteImages, together with
+// the instructions below, so a provider that can't send images never sees either.
+import {
+  findNoteMediaNames,
+  noteMediaNameFromUrl,
+  noteMediaPastedAt,
+  noteMediaUrl,
+} from "../helpers/noteMediaLinks";
+import type { NoteImageAttachments } from "../services/BaseReasoningService";
+import type { TranscriptSegment } from "../stores/meetingRecordingStore";
+import { resolveLlmSpeakerLabel } from "./llmTranscript";
+
+type Translate = (key: string, options?: Record<string, unknown>) => string;
+
+export interface NoteScreenshot {
+  name: string;
+  url: string;
+  /** "Screenshot 2" */
+  title: string;
+  /** "Screenshot 2, pasted 10:04" */
+  label: string;
+  pastedAt: number | null;
+}
+
+// A screenshot pasted this long before the first or after the last transcript
+// segment still belongs to the meeting (e.g. the title slide before anyone spoke).
+const MEETING_MARGIN_MS = 2 * 60 * 1000;
+
+// ![alt](url "title"); alt and title may contain backslash escapes.
+const MARKDOWN_IMAGE_RE = /!\[(?:\\.|[^\]\\])*\]\(\s*<?([^)\s>]*)>?(?:\s+"(?:\\.|[^"\\])*")?\s*\)/g;
+
+export function formatClock(ms: number): string {
+  const date = new Date(ms);
+  return `${String(date.getHours()).padStart(2, "0")}:${String(date.getMinutes()).padStart(2, "0")}`;
+}
+
+export function collectNoteScreenshots(markdown: string): NoteScreenshot[] {
+  return findNoteMediaNames(markdown).map((name, index) => {
+    const pastedAt = noteMediaPastedAt(name);
+    const title = `Screenshot ${index + 1}`;
+    return {
+      name,
+      url: noteMediaUrl(name),
+      title,
+      label: pastedAt ? `${title}, pasted ${formatClock(pastedAt)}` : title,
+      pastedAt,
+    };
+  });
+}
+
+/** Replaces each screenshot's Markdown image with its label. */
+export function labelScreenshotsInMarkdown(markdown: string, shots: NoteScreenshot[]): string {
+  const byName = new Map(shots.map((shot) => [shot.name, shot]));
+  return markdown.replace(MARKDOWN_IMAGE_RE, (match, url: string) => {
+    const shot = byName.get(noteMediaNameFromUrl(url) ?? "");
+    return shot ? `[${shot.label}]` : match;
+  });
+}
+
+/**
+ * buildLlmTranscript with a "[Screenshot N, pasted HH:MM]" line before the first
+ * segment that started after the paste. Segment timestamps and paste times are both
+ * wall-clock ms. Screenshots pasted outside the meeting only appear in the notes.
+ */
+export function buildLlmTranscriptWithScreenshots(
+  segments: TranscriptSegment[],
+  speakerMappings: Record<string, string>,
+  selfLabel: string,
+  t: Translate,
+  shots: NoteScreenshot[]
+): string {
+  const lines = segments.map(
+    (segment) =>
+      `${resolveLlmSpeakerLabel(segment, speakerMappings, selfLabel, t)}: ${segment.text}`
+  );
+  const times = segments
+    .map((segment) => segment.timestamp)
+    .filter((time): time is number => Number.isFinite(time));
+  if (times.length === 0) return lines.join("\n");
+
+  const first = times.reduce((a, b) => Math.min(a, b));
+  const last = times.reduce((a, b) => Math.max(a, b));
+  const pending = shots
+    .filter(
+      (shot) =>
+        shot.pastedAt != null &&
+        shot.pastedAt >= first - MEETING_MARGIN_MS &&
+        shot.pastedAt <= last + MEETING_MARGIN_MS
+    )
+    .sort((a, b) => a.pastedAt! - b.pastedAt!);
+
+  const out: string[] = [];
+  let next = 0;
+  segments.forEach((segment, index) => {
+    const time = segment.timestamp;
+    while (next < pending.length && Number.isFinite(time) && pending[next].pastedAt! < time!) {
+      out.push(`[${pending[next++].label}]`);
+    }
+    out.push(lines[index]);
+  });
+  while (next < pending.length) out.push(`[${pending[next++].label}]`);
+  return out.join("\n");
+}
+
+export function buildScreenshotInstructions(shots: NoteScreenshot[], inline: boolean): string {
+  const count = shots.length === 1 ? "1 screenshot" : `${shots.length} screenshots`;
+  const lines = [
+    "## Screenshots",
+    `The user pasted ${count} into these notes, typically of slides, documents or dashboards someone presented. They are attached below as images, each introduced by its label. "[Screenshot N, pasted HH:MM]" in the notes or the transcript marks where each one was pasted, which is close to when it was on screen.`,
+    "",
+    "Treat what the screenshots show as source material with the same weight as the transcript. Keep their exact names, figures, dates and wording, and connect them to what was being said at the time.",
+    "",
+  ];
+  if (inline) {
+    lines.push(
+      "Where a screenshot directly supports a section of your output, put it on its own line after that section's text, copying its Markdown image exactly from this list:",
+      ...shots.map((shot) => `- ![${shot.title}](${shot.url})`),
+      "Use each screenshot at most once, and only where it helps the reader. Don't write any other image links."
+    );
+  } else {
+    lines.push(
+      "Don't put images or image links in your output. Where a screenshot matters, state what it shows in words."
+    );
+  }
+  return lines.join("\n");
+}
+
+/**
+ * Keeps only image links to the attached screenshots, each at most once, and only
+ * when the action may place them. Anything else the model wrote as an image goes.
+ */
+export function sanitizeScreenshotLinks(
+  output: string,
+  shots: NoteScreenshot[],
+  inline: boolean
+): string {
+  const allowed = new Set(inline ? shots.map((shot) => shot.name) : []);
+  const used = new Set<string>();
+  let removed = false;
+  const kept = output.replace(MARKDOWN_IMAGE_RE, (match, url: string) => {
+    const name = noteMediaNameFromUrl(url);
+    if (name && allowed.has(name) && !used.has(name)) {
+      used.add(name);
+      return match;
+    }
+    removed = true;
+    return "";
+  });
+  return removed ? kept.replace(/\n{3,}/g, "\n\n").trim() : kept;
+}
+
+/** Loads the screenshots from disk, downscaled for the model. Null if none could be read. */
+export async function loadScreenshotAttachments(
+  shots: NoteScreenshot[],
+  inline: boolean
+): Promise<{ attached: NoteScreenshot[]; attachments: NoteImageAttachments } | null> {
+  if (shots.length === 0) return null;
+  const loaded =
+    (await window.electronAPI
+      ?.loadNoteImagesForModel?.(shots.map((shot) => shot.name))
+      .catch(() => null)) ?? [];
+  const pairs = shots
+    .map((shot, index) => ({ shot, image: loaded[index] }))
+    .filter((pair) => !!pair.image);
+  if (pairs.length === 0) return null;
+  const attached = pairs.map((pair) => pair.shot);
+  return {
+    attached,
+    attachments: {
+      instructions: buildScreenshotInstructions(attached, inline),
+      images: pairs.map(({ shot, image }) => ({
+        label: shot.label,
+        mediaType: image!.mediaType,
+        data: image!.data,
+      })),
+    },
+  };
+}
diff --git a/test/utils/noteScreenshots.test.js b/test/utils/noteScreenshots.test.js
new file mode 100644
index 00000000..c61b3142
--- /dev/null
+++ b/test/utils/noteScreenshots.test.js
@@ -0,0 +1,150 @@
+// Local patch: screenshots pasted into notes (src/utils/noteScreenshots.ts).
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const load = () => import("../../src/utils/noteScreenshots.ts");
+const loadLinks = () => import("../../src/helpers/noteMediaLinks.js");
+const loadContent = () => import("../../src/services/ai/noteImageContent.ts");
+
+const t = (key, options) => {
+  if (key === "notes.speaker.label") return `Speaker ${options.n}`;
+  if (key === "notes.speaker.them") return "Them";
+  return key;
+};
+
+const at = (h, m, s = 0) => new Date(2026, 8, 25, h, m, s).getTime();
+const media = (ms, hex = "0a1b2c3d") => `${ms}-${hex}.png`;
+const link = (name, alt = "Screenshot") => `![${alt}](openwhispr-media://image/${name})`;
+
+test("media names carry the paste time and reject anything else", async () => {
+  const { noteMediaNameFromUrl, noteMediaPastedAt, findNoteMediaNames } = await loadLinks();
+  const name = media(at(10, 4));
+  assert.equal(noteMediaNameFromUrl(`openwhispr-media://image/${name}`), name);
+  assert.equal(noteMediaPastedAt(name), at(10, 4));
+  assert.equal(noteMediaNameFromUrl("openwhispr-media://image/../secrets.png"), null);
+  assert.equal(noteMediaNameFromUrl("https://example.com/a.png"), null);
+  const other = media(at(10, 9), "ffffffff");
+  assert.deepEqual(findNoteMediaNames(`${link(name)} x ${link(other)} ${link(name)}`), [
+    name,
+    other,
+  ]);
+});
+
+test("screenshots are numbered in note order and labelled with the paste time", async () => {
+  const { collectNoteScreenshots, labelScreenshotsInMarkdown } = await load();
+  const a = media(at(10, 4));
+  const b = media(at(10, 31), "ffffffff");
+  const notes = `Agenda\n\n${link(a, "Screenshot 10:04")}\n\nBudget ${link(b)}`;
+  const shots = collectNoteScreenshots(notes);
+  assert.deepEqual(
+    shots.map((s) => [s.title, s.label]),
+    [
+      ["Screenshot 1", "Screenshot 1, pasted 10:04"],
+      ["Screenshot 2", "Screenshot 2, pasted 10:31"],
+    ]
+  );
+  assert.equal(
+    labelScreenshotsInMarkdown(notes, shots),
+    "Agenda\n\n[Screenshot 1, pasted 10:04]\n\nBudget [Screenshot 2, pasted 10:31]"
+  );
+  // Other images are left alone.
+  assert.equal(labelScreenshotsInMarkdown("![x](https://e.com/x.png)", shots), "![x](https://e.com/x.png)");
+});
+
+test("transcript gets a marker before the first segment that started after the paste", async () => {
+  const { collectNoteScreenshots, buildLlmTranscriptWithScreenshots } = await load();
+  const segments = [
+    { source: "mic", text: "agendana on viisi", timestamp: at(10, 3, 50) },
+    { source: "system", speaker: "speaker_0", text: "tässä luvut", timestamp: at(10, 4, 20) },
+    { source: "mic", text: "kiitos", timestamp: at(10, 20) },
+  ];
+  const shots = collectNoteScreenshots(
+    [at(10, 4, 5), at(9, 0), at(10, 21)].map((ms, i) => link(media(ms, `0000000${i}`))).join(" ")
+  );
+  assert.equal(
+    buildLlmTranscriptWithScreenshots(segments, {}, "Pasi", t, shots),
+    [
+      "Pasi: agendana on viisi",
+      "[Screenshot 1, pasted 10:04]",
+      "Speaker 1: tässä luvut",
+      "Pasi: kiitos",
+      "[Screenshot 3, pasted 10:21]",
+    ].join("\n")
+  );
+  // Screenshot 2 was pasted an hour before the meeting, so it stays in the notes only.
+});
+
+test("transcript without timestamps is unchanged", async () => {
+  const { collectNoteScreenshots, buildLlmTranscriptWithScreenshots } = await load();
+  const { buildLlmTranscript } = await import("../../src/utils/llmTranscript.ts");
+  const segments = [{ source: "mic", text: "hei" }];
+  const shots = collectNoteScreenshots(link(media(at(10, 4))));
+  assert.equal(
+    buildLlmTranscriptWithScreenshots(segments, {}, "Pasi", t, shots),
+    buildLlmTranscript(segments, {}, "Pasi", t)
+  );
+});
+
+test("instructions list the links only when the action may place images", async () => {
+  const { collectNoteScreenshots, buildScreenshotInstructions } = await load();
+  const name = media(at(10, 4));
+  const shots = collectNoteScreenshots(link(name));
+  const inline = buildScreenshotInstructions(shots, true);
+  assert.match(inline, /The user pasted 1 screenshot into these notes/);
+  assert.ok(inline.includes(`- ![Screenshot 1](openwhispr-media://image/${name})`));
+  const email = buildScreenshotInstructions(shots, false);
+  assert.ok(!email.includes("openwhispr-media://"));
+  assert.match(email, /Don't put images or image links in your output/);
+});
+
+test("output keeps attached screenshots once and drops every other image", async () => {
+  const { collectNoteScreenshots, sanitizeScreenshotLinks } = await load();
+  const a = media(at(10, 4));
+  const shots = collectNoteScreenshots(link(a));
+  const made_up = media(at(10, 5), "deadbeef");
+  const output = [
+    "## Budget",
+    "- Marketing 42 000 EUR",
+    "",
+    link(a, "Screenshot 1"),
+    "",
+    link(a, "Screenshot 1"),
+    "",
+    link(made_up),
+    "",
+    "![logo](https://example.com/logo.png)",
+    "",
+    "## Next",
+  ].join("\n");
+  assert.equal(
+    sanitizeScreenshotLinks(output, shots, true),
+    `## Budget\n- Marketing 42 000 EUR\n\n${link(a, "Screenshot 1")}\n\n## Next`
+  );
+  assert.equal(
+    sanitizeScreenshotLinks(output, shots, false),
+    "## Budget\n- Marketing 42 000 EUR\n\n## Next"
+  );
+  assert.equal(sanitizeScreenshotLinks("no images", shots, true), "no images");
+});
+
+test("user content carries text, instructions, then labelled images", async () => {
+  const { noteImageUserContent } = await loadContent();
+  assert.equal(noteImageUserContent("notes", {}), null);
+  const config = {
+    noteImages: {
+      instructions: "## Screenshots",
+      images: [{ label: "Screenshot 1, pasted 10:04", mediaType: "image/png", data: "AAAA" }],
+    },
+  };
+  assert.deepEqual(noteImageUserContent("notes", config, "chat"), [
+    { type: "text", text: "notes" },
+    { type: "text", text: "## Screenshots" },
+    { type: "text", text: "Screenshot 1, pasted 10:04:" },
+    { type: "image_url", image_url: { url: "data:image/png;base64,AAAA", detail: "high" } },
+  ]);
+  assert.deepEqual(noteImageUserContent("notes", config, "responses").at(-1), {
+    type: "input_image",
+    image_url: "data:image/png;base64,AAAA",
+    detail: "high",
+  });
+});
