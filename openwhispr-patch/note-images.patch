diff --git a/src/components/ui/noteImageExtension.ts b/src/components/ui/noteImageExtension.ts
new file mode 100644
index 00000000..330c3349
--- /dev/null
+++ b/src/components/ui/noteImageExtension.ts
@@ -0,0 +1,103 @@
+// Local patch: screenshots in the note editor. Pasting or dropping an image saves
+// it through the main process (noteMedia.js) and inserts ![Screenshot HH:MM](openwhispr-media://…).
+// tiptap-markdown serializes any node named "image" as Markdown image syntax.
+import { Node, mergeAttributes } from "@tiptap/core";
+import { Plugin, PluginKey } from "@tiptap/pm/state";
+import type { EditorView } from "@tiptap/pm/view";
+import { noteMediaNameFromUrl, noteMediaPastedAt } from "../../helpers/noteMediaLinks";
+import { formatClock } from "../../utils/noteScreenshots";
+
+const imageFiles = (list: FileList | null | undefined) =>
+  Array.from(list ?? []).filter((file) => file.type.startsWith("image/"));
+
+async function insertImages(view: EditorView, files: File[], at: number | null) {
+  let pos = at;
+  for (const file of files) {
+    const bytes = new Uint8Array(await file.arrayBuffer());
+    const saved = await window.electronAPI?.saveNoteImage?.(bytes, file.type);
+    if (!saved?.success || !saved.url || !saved.name) {
+      console.warn("Pasted image was not saved", saved?.error);
+      continue;
+    }
+    if (view.isDestroyed) return;
+    const pastedAt = noteMediaPastedAt(saved.name) ?? Date.now();
+    const node = view.state.schema.nodes.image.create({
+      src: saved.url,
+      alt: `Screenshot ${formatClock(pastedAt)}`,
+    });
+    const tr =
+      pos == null
+        ? view.state.tr.replaceSelectionWith(node)
+        : view.state.tr.replaceRangeWith(
+            Math.min(pos, view.state.doc.content.size),
+            Math.min(pos, view.state.doc.content.size),
+            node
+          );
+    view.dispatch(tr.scrollIntoView());
+    if (pos != null) pos = tr.mapping.map(pos);
+  }
+}
+
+export const NoteImage = Node.create({
+  name: "image",
+  // Before Link's paste handler, so an image paste never reaches it.
+  priority: 1000,
+  inline: true,
+  group: "inline",
+  atom: true,
+  draggable: true,
+
+  addAttributes() {
+    return {
+      src: { default: null },
+      alt: { default: null },
+      title: { default: null },
+    };
+  },
+
+  // Only our own screenshots: an <img> pasted from a web page must not make the
+  // app fetch remote images.
+  parseHTML() {
+    return [
+      {
+        tag: "img[src]",
+        getAttrs: (element) =>
+          noteMediaNameFromUrl((element as HTMLElement).getAttribute("src")) ? null : false,
+      },
+    ];
+  },
+
+  renderHTML({ HTMLAttributes }) {
+    return ["img", mergeAttributes(HTMLAttributes, { class: "note-image" })];
+  },
+
+  addProseMirrorPlugins() {
+    return [
+      new Plugin({
+        key: new PluginKey("noteImagePaste"),
+        props: {
+          handlePaste(view, event) {
+            const data = event.clipboardData;
+            const files = imageFiles(data?.files);
+            // Spreadsheets and some editors put a picture of the copied cells next
+            // to the text; that paste is text.
+            if (!view.editable || files.length === 0 || data?.getData("text/plain").trim()) {
+              return false;
+            }
+            event.preventDefault();
+            void insertImages(view, files, null);
+            return true;
+          },
+          handleDrop(view, event, _slice, moved) {
+            const files = imageFiles(event.dataTransfer?.files);
+            if (!view.editable || moved || files.length === 0) return false;
+            event.preventDefault();
+            const at = view.posAtCoords({ left: event.clientX, top: event.clientY });
+            void insertImages(view, files, at?.pos ?? null);
+            return true;
+          },
+        },
+      }),
+    ];
+  },
+});
diff --git a/src/helpers/noteMedia.js b/src/helpers/noteMedia.js
new file mode 100644
index 00000000..c7474ee4
--- /dev/null
+++ b/src/helpers/noteMedia.js
@@ -0,0 +1,178 @@
+// Screenshots pasted into notes. The files live in <userData>/note-media and
+// notes link to them as openwhispr-media://image/<name> (see noteMediaLinks.js),
+// so note text, search, sync and the Markdown mirror only carry a short link.
+const fs = require("fs");
+const path = require("path");
+const crypto = require("crypto");
+const { app, ipcMain, nativeImage, protocol } = require("electron");
+const {
+  NOTE_MEDIA_SCHEME,
+  NOTE_MEDIA_NAME_RE,
+  findNoteMediaNames,
+  noteMediaPastedAt,
+  noteMediaUrl,
+} = require("./noteMediaLinks");
+
+const MAX_SAVE_BYTES = 25 * 1024 * 1024;
+// Images sent to a note action: long edge capped at 2048px, each kept under
+// ~1 MB so a note with dozens of screenshots still fits one request.
+const MODEL_MAX_EDGE_PX = 2048;
+const MODEL_FALLBACK_EDGE_PX = 1568;
+const MODEL_MAX_BYTES = 1024 * 1024;
+const MODEL_MAX_IMAGES = 40;
+// Files no live note links to are deleted at startup, once they're this old:
+// a just-pasted image may not have been autosaved into its note yet.
+const ORPHAN_MIN_AGE_MS = 24 * 60 * 60 * 1000;
+
+const log = () => require("./debugLogger");
+
+function mediaDir() {
+  return path.join(app.getPath("userData"), "note-media");
+}
+
+function mediaPath(name) {
+  return typeof name === "string" && NOTE_MEDIA_NAME_RE.test(name)
+    ? path.join(mediaDir(), name)
+    : null;
+}
+
+const mimeFor = (name) => (name.endsWith(".jpg") ? "image/jpeg" : "image/png");
+
+// Must run before the app's ready event. `standard` makes the URL parse with a
+// host (image) and path (the file name); `secure` lets pages load it like https.
+function registerScheme() {
+  protocol.registerSchemesAsPrivileged([
+    {
+      scheme: NOTE_MEDIA_SCHEME,
+      privileges: { standard: true, secure: true, supportFetchAPI: true },
+    },
+  ]);
+}
+
+async function serve(request) {
+  let name = null;
+  try {
+    const url = new URL(request.url);
+    if (url.hostname === "image") name = decodeURIComponent(url.pathname.slice(1));
+  } catch {
+    // fall through to 404
+  }
+  const file = mediaPath(name);
+  if (!file) return new Response("Not found", { status: 404 });
+  try {
+    const data = await fs.promises.readFile(file);
+    return new Response(data, {
+      headers: { "Content-Type": mimeFor(name), "Cache-Control": "private, max-age=31536000" },
+    });
+  } catch {
+    return new Response("Not found", { status: 404 });
+  }
+}
+
+async function save(bytes, mimeType) {
+  const buffer = Buffer.from(bytes || []);
+  if (buffer.length === 0 || buffer.length > MAX_SAVE_BYTES) {
+    throw new Error("Image is empty or larger than 25 MB");
+  }
+  const image = nativeImage.createFromBuffer(buffer);
+  if (image.isEmpty()) throw new Error(`Unsupported image (${mimeType || "unknown type"})`);
+  // PNG and JPEG are stored as pasted; anything else nativeImage can decode becomes PNG.
+  const isJpeg = mimeType === "image/jpeg";
+  const data = isJpeg || mimeType === "image/png" ? buffer : image.toPNG();
+  const name = `${Date.now()}-${crypto.randomBytes(4).toString("hex")}.${isJpeg ? "jpg" : "png"}`;
+  await fs.promises.mkdir(mediaDir(), { recursive: true });
+  await fs.promises.writeFile(path.join(mediaDir(), name), data);
+  return { name, url: noteMediaUrl(name) };
+}
+
+function fitWithin(image, maxEdge) {
+  const { width, height } = image.getSize();
+  const scale = Math.min(1, maxEdge / Math.max(width, height));
+  return scale < 1
+    ? image.resize({
+        width: Math.round(width * scale),
+        height: Math.round(height * scale),
+        quality: "best",
+      })
+    : image;
+}
+
+// Slides and documents are usually smaller as PNG and stay sharper; photos and
+// video frames are smaller as JPEG. Send whichever is smaller.
+function encodeSmallest(image) {
+  const png = image.toPNG();
+  const jpeg = image.toJPEG(88);
+  return png.length <= jpeg.length
+    ? { mediaType: "image/png", bytes: png }
+    : { mediaType: "image/jpeg", bytes: jpeg };
+}
+
+function loadForModel(name) {
+  const file = mediaPath(name);
+  if (!file || !fs.existsSync(file)) return null;
+  const source = nativeImage.createFromPath(file);
+  if (source.isEmpty()) return null;
+  let encoded = encodeSmallest(fitWithin(source, MODEL_MAX_EDGE_PX));
+  if (encoded.bytes.length > MODEL_MAX_BYTES) {
+    encoded = encodeSmallest(fitWithin(source, MODEL_FALLBACK_EDGE_PX));
+  }
+  return { name, mediaType: encoded.mediaType, data: encoded.bytes.toString("base64") };
+}
+
+function sweepOrphans(databaseManager) {
+  const dir = mediaDir();
+  if (!databaseManager?.db || !fs.existsSync(dir)) return;
+  const referenced = new Set();
+  const rows = databaseManager.db
+    .prepare("SELECT content, enhanced_content FROM notes WHERE deleted_at IS NULL")
+    .all();
+  for (const row of rows) {
+    for (const name of findNoteMediaNames(`${row.content || ""}\n${row.enhanced_content || ""}`)) {
+      referenced.add(name);
+    }
+  }
+  const cutoff = Date.now() - ORPHAN_MIN_AGE_MS;
+  let removed = 0;
+  for (const name of fs.readdirSync(dir)) {
+    if (!NOTE_MEDIA_NAME_RE.test(name) || referenced.has(name)) continue;
+    if ((noteMediaPastedAt(name) ?? Infinity) > cutoff) continue;
+    fs.rmSync(path.join(dir, name), { force: true });
+    removed++;
+  }
+  if (removed > 0) log().info("Removed unlinked note screenshots", { removed }, "noteMedia");
+}
+
+// After app ready: serve the files, register IPC, and clean up in the background.
+function start(databaseManager) {
+  protocol.handle(NOTE_MEDIA_SCHEME, serve);
+
+  ipcMain.handle("note-media-save", async (_event, bytes, mimeType) => {
+    try {
+      return { success: true, ...(await save(bytes, mimeType)) };
+    } catch (error) {
+      log().warn("Saving pasted image failed", { error: error.message }, "noteMedia");
+      return { success: false, error: error.message };
+    }
+  });
+
+  ipcMain.handle("note-media-load-for-model", async (_event, names) =>
+    (Array.isArray(names) ? names.slice(0, MODEL_MAX_IMAGES) : []).map((name) => {
+      try {
+        return loadForModel(name);
+      } catch (error) {
+        log().warn("Loading note screenshot failed", { name, error: error.message }, "noteMedia");
+        return null;
+      }
+    })
+  );
+
+  setTimeout(() => {
+    try {
+      sweepOrphans(databaseManager);
+    } catch (error) {
+      log().warn("Note screenshot cleanup failed", { error: error.message }, "noteMedia");
+    }
+  }, 60_000).unref();
+}
+
+module.exports = { registerScheme, start, MODEL_MAX_IMAGES };
diff --git a/src/helpers/noteMediaLinks.js b/src/helpers/noteMediaLinks.js
new file mode 100644
index 00000000..ecc1d2ee
--- /dev/null
+++ b/src/helpers/noteMediaLinks.js
@@ -0,0 +1,35 @@
+// Links to screenshots pasted into notes: ![Screenshot 10:04](openwhispr-media://image/<name>).
+// Shared by the main process, which stores and serves the files (noteMedia.js),
+// and the renderer, which inserts them and sends them to note actions.
+
+export const NOTE_MEDIA_SCHEME = "openwhispr-media";
+export const NOTE_MEDIA_URL_PREFIX = `${NOTE_MEDIA_SCHEME}://image/`;
+
+// <paste time in epoch ms>-<8 hex chars>.<png|jpg>. The name carries the paste
+// time so no separate metadata has to be stored or synced.
+export const NOTE_MEDIA_NAME_RE = /^(\d{13})-[0-9a-f]{8}\.(?:png|jpg)$/;
+const NOTE_MEDIA_URL_RE = /openwhispr-media:\/\/image\/(\d{13}-[0-9a-f]{8}\.(?:png|jpg))/g;
+
+export function noteMediaUrl(name) {
+  return NOTE_MEDIA_URL_PREFIX + name;
+}
+
+export function noteMediaNameFromUrl(url) {
+  if (typeof url !== "string" || !url.startsWith(NOTE_MEDIA_URL_PREFIX)) return null;
+  const name = url.slice(NOTE_MEDIA_URL_PREFIX.length);
+  return NOTE_MEDIA_NAME_RE.test(name) ? name : null;
+}
+
+export function noteMediaPastedAt(name) {
+  const match = NOTE_MEDIA_NAME_RE.exec(name || "");
+  return match ? Number(match[1]) : null;
+}
+
+/** File names of every screenshot linked in the text, first occurrence order, no duplicates. */
+export function findNoteMediaNames(text) {
+  const names = [];
+  for (const match of String(text || "").matchAll(NOTE_MEDIA_URL_RE)) {
+    if (!names.includes(match[1])) names.push(match[1]);
+  }
+  return names;
+}
