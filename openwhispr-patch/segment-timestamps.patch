+// Local patch: segment timestamps.
+test("a final that arrives after the next turn started keeps its own turn's start time", async (t) => {
+  const OpenAIRealtimeStreaming = (await load()).default;
+  const streaming = new OpenAIRealtimeStreaming();
+  const socket = makeFakeSocket(WS.CONNECTING);
+  await connectByok(streaming, socket);
+  const finals = [];
+  streaming.onFinalTranscript = (text, timestamp) => finals.push({ text, timestamp });
+  t.mock.timers.enable({ apis: ["Date"], now: 1_000 });
+  const emit = (event) => socket.emit("message", JSON.stringify(event));
+  const completed = (item_id, transcript) =>
+    emit({ type: "conversation.item.input_audio_transcription.completed", item_id, transcript });
+
+  emit({ type: "input_audio_buffer.speech_started", item_id: "item_a" });
+  t.mock.timers.tick(6_000);
+  emit({ type: "input_audio_buffer.committed", item_id: "item_a" });
+  t.mock.timers.tick(1_000);
+  // The next speaker starts before item_a's transcript comes back.
+  emit({ type: "input_audio_buffer.speech_started", item_id: "item_b" });
+  t.mock.timers.tick(500);
+  completed("item_a", "First speaker.");
+  t.mock.timers.tick(4_000);
+  emit({ type: "input_audio_buffer.committed", item_id: "item_b" });
+  t.mock.timers.tick(1_500);
+  completed("item_b", "Second speaker.");
+
+  assert.deepEqual(
+    finals.map((f) => f.timestamp),
+    [1_000, 8_000]
+  );
+  assert.equal(streaming.speechStartTimes.size, 0);
+  streaming.cleanup();
+});
+
